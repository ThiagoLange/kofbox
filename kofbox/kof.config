# Porta do daemon (KOF_SERVER_PORT tem precedência via env por convenção)
server.port=8080

# --- Opções do KofBox (descomente para usar) ---
# Formato: chave=valor, comentários com #. Variáveis de ambiente
# KOF_<CHAVE_MAIUSCULA> têm precedência sobre este arquivo.
# Ex.: KOF_KOFBOX_API_KEY=segredo KOF_KOFBOX_TIMEOUT_SECONDS=30

# Exige header `x-api-key` com este valor em /api/execute e /api/history.
# Vazio/ausente = auth desabilitada (modo demo local).
# kofbox.api-key=troque-esta-chave

# Timeout por execução, em segundos (padrão 15, mínimo efetivo 1).
# kofbox.timeout-seconds=15

# Arquivo de histórico JSONL (padrão: history.jsonl no working dir).
# kofbox.history-file=history.jsonl
